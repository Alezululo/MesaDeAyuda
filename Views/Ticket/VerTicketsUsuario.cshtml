@model List<MesaDeAyuda.Models.Entities.Ticket>

@{
    ViewData["Title"] = "Mis Solicitudes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-layout">
    <div class="sidebar">
        <h2>Portal Usuario</h2>
        <ul>
            <li><a href="@Url.Action("Create", "Ticket")">Registrar Solicitud</a></li>
            <li><a href="@Url.Action("MyTickets", "Ticket")">Consultar Estado</a></li>
            <li><a href="@Url.Action("Index", "Home")">← Volver al menú principal</a></li>
        </ul>
    </div>

    <div class="main">
        <div class="header">
            <h1>Mis Solicitudes</h1>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="message-success">@TempData["SuccessMessage"]</div>
            <br />
        }

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Título</th>
                        <th>Técnico</th>
                        <th>Prioridad</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="tablaBody">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var t in Model)
                        {
                            <tr>
                                <td>@t.Codigo</td>
                                <td>@t.Titulo</td>
                                <td>
                                    @(t.TecnicoAsignado != null ? t.TecnicoAsignado.Nombre : "Sin asignar")
                                </td>
                                <td>
                                    <span class="prioridad-@t.Prioridad.Nombre.ToLower().Replace(" ", "").Replace("í", "i")">
                                        @t.Prioridad.Nombre
                                    </span>
                                </td>
                                <td>
                                    <span class="status @t.Estado.Nombre.ToLower().Replace(" ", "")">
                                        @t.Estado.Nombre
                                    </span>
                                </td>
                                <td>
                                    <button class="btn-action" onclick="verTicket(@t.Id)">
                                        Ver
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">No tienes solicitudes registradas.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINACIÓN -->
        <div id="paginacion" class="paginacion"></div>

    </div>

    <div id="modalTicket" class="modal">
        <div class="modal-content modal-large">
    
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <h3>Detalle del Ticket</h3>
                <button class="btn-action" onclick="cerrarModal()">X</button>
            </div>

            <div id="contenidoModal"></div>

        </div>
    </div>
</div>

<div class="theme-switch">
    <label class="switch">
        <input type="checkbox" onchange="toggleTheme()">
        <span class="slider"></span>
    </label>
</div>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/my-tickets.js" asp-append-version="true"></script>
}